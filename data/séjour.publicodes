séjour . voiture . électrique . consommation estimée:
  variations:
    - si: gabarit = 'petite'
      alors: 15
    - si: gabarit = 'moyenne'
      alors: 17
    - si: gabarit = 'berline'
      alors: 25
    - si: gabarit = 'SUV'
      alors: 25
    - si: gabarit = 'VUL'
      alors: 25
